{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tenant-table-tune",
  // Keep at or below the workerd release bundled with the installed wrangler,
  // or `vite dev` refuses to start.
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  // src/server.ts wraps TanStack Start's server entry with the SSR error page
  // and copies Worker env bindings into process.env (see populateProcessEnv).
  "main": "src/server.ts",
  "observability": {
    "enabled": true
  },
  // Preview deployments use staging only. No production credentials or secrets
  // belong in this block; the publishable key is public by design.
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://mjominccvkwyintjsxja.supabase.co",
      "VITE_APP_ENV": "staging",
      "VITE_CASHFREE_MODE": "sandbox",
      "VITE_SITE_URL": "https://release-tenant-table-tune.ygulhane135.workers.dev",
      "VITE_SUPABASE_PROJECT_ID": "mjominccvkwyintjsxja",
      "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_2Inum7qcusFgnqroy2Ft_g_jw457rFJ",
      "VITE_SUPABASE_URL": "https://mjominccvkwyintjsxja.supabase.co"
    }
  },
  // keep_vars preserves other dashboard variables. Secrets remain managed
  // separately as runtime secrets.
  "keep_vars": true
}
