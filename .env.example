# Copy to .env.local for local development and fill in the STAGING values.
# Never point local development at production. Never commit real values:
# .env and .env.* are git-ignored; only this template is tracked.
#
# Two kinds of variable:
#   VITE_*  build-time, inlined into the browser bundle by Vite. Public by
#           design — NEVER put a service-role / secret key in a VITE_ variable.
#           Changing one in Cloudflare needs a rebuild/redeploy.
#   others  server-only. Locally they come from this file; in Cloudflare they
#           are Worker variables/secrets (runtime), set per Worker.
# See docs/supabase-environments.md for which value goes where.
#
# Guard rails (src/config/supabase-env.ts, enforced at build AND at runtime):
#   development            → refuses the production project
#   staging                → accepts only DineEatz Staging (mjominccvkwyintjsxja)
#   production             → accepts only the production project
# So these staging values can't accidentally reach production, and an old .env
# with production values makes `npm run dev` stop with a clear error.

# ---- Environment -----------------------------------------------------------
# development | staging | production. Shows the STAGING/DEV badge unless "production".
VITE_APP_ENV=development

# ---- Supabase (build-time, public) ------------------------------------------
VITE_SUPABASE_URL=https://mjominccvkwyintjsxja.supabase.co
# Publishable (or legacy anon) key. A secret / service-role key here fails the build.
VITE_SUPABASE_PUBLISHABLE_KEY=<staging publishable key: Staging → Project Settings → API Keys>
# Optional; when set it must match the ref in VITE_SUPABASE_URL.
VITE_SUPABASE_PROJECT_ID=mjominccvkwyintjsxja

# ---- Site ------------------------------------------------------------------
# Optional. Canonical / Open Graph origin. Defaults to https://dineeatz.in.
# Auth redirects always use the current origin, so this doesn't affect login.
# VITE_SITE_URL=https://staging.example.com

# ---- Payments (build-time, public) -------------------------------------------
# sandbox | production. Staging and local: sandbox.
VITE_CASHFREE_MODE=sandbox
# UPI QR on invoices. Staging: a test UPI ID, so nobody pays the real account.
VITE_UPI_ID=test@upi
VITE_UPI_PAYEE_NAME=DineEatz Staging

# ---- Server-only (runtime) ---------------------------------------------------
# The server uses the same VITE_SUPABASE_URL as the browser; there is no
# separate runtime SUPABASE_URL any more.
# SECRET. Staging project's key. Bypasses RLS. Rejected if it belongs to a
# different project than VITE_SUPABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=<staging secret key: Staging → Project Settings → API Keys>

# Cashfree subscription payments. sandbox | production. Staging: sandbox + sandbox keys.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=<cashfree-sandbox-app-id>
CASHFREE_SECRET_KEY=<cashfree-sandbox-secret>

# WhatsApp via Twilio. Staging: Twilio test credentials or the WhatsApp sandbox sender.
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Shared secret for /api/public/whatsapp-dispatch (any long random string, different per environment).
WHATSAPP_DISPATCH_SECRET=<random-string>

# ---- Supabase CLI (npm run db:link:*) — not used by the app -----------------
SUPABASE_STAGING_REF=mjominccvkwyintjsxja
SUPABASE_PROD_REF=khvvukyedvuqvbemjcxb
